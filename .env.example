# AirLLM Environment Configuration
# Copy this file to .env and adjust values for your environment

# Python Backend
AIRLLM_AUTO_UPGRADE_TRANSFORMERS=false
AIRLLM_CACHE_DIR=~/.cache/huggingface
AIRLLM_LOG_LEVEL=INFO

# Desktop App
TAURI_DEV_URL=http://localhost:1420
TAURI_BUILD_TARGET=all

# Android App (for reference - actual configs in gradle)
ANDROID_MIN_SDK=26
ANDROID_TARGET_SDK=36

# Model Configuration
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_COMPRESSION=4bit

# Security
ENABLE_TELEMETRY=false
